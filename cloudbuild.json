{
  "steps": [
    {
      "name": "gcr.io/cloud-builders/docker",
      "id": "Build",
      "args": [
        "build",
        "--no-cache",
        "-t",
        "europe-west1-docker.pkg.dev/$PROJECT_ID/rupan/rupan:$BUILD_ID",
        "--build-arg",
        "NEXT_PUBLIC_SUPABASE_URL=${_NEXT_PUBLIC_SUPABASE_URL}",
        "--build-arg",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY=${_NEXT_PUBLIC_SUPABASE_ANON_KEY}",
        "--build-arg",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=${_NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY}",
        "--build-arg",
        "NEXT_PUBLIC_APP_URL=${_NEXT_PUBLIC_APP_URL}",
        "."
      ]
    },
    {
      "name": "gcr.io/cloud-builders/docker",
      "id": "Push",
      "args": [
        "push",
        "europe-west1-docker.pkg.dev/$PROJECT_ID/rupan/rupan:$BUILD_ID"
      ]
    },
    {
      "name": "gcr.io/google.com/cloudsdktool/cloud-sdk:slim",
      "id": "Deploy",
      "entrypoint": "gcloud",
      "args": [
        "run",
        "deploy",
        "rupan",
        "--project=$PROJECT_ID",
        "--image=europe-west1-docker.pkg.dev/$PROJECT_ID/rupan/rupan:$BUILD_ID",
        "--region=europe-west1",
        "--platform=managed",
        "--allow-unauthenticated",
        "--port=8080",
        "--update-env-vars=NEXT_PUBLIC_SUPABASE_URL=${_NEXT_PUBLIC_SUPABASE_URL},NEXT_PUBLIC_SUPABASE_ANON_KEY=${_NEXT_PUBLIC_SUPABASE_ANON_KEY},NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=${_NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY},NEXT_PUBLIC_APP_URL=${_NEXT_PUBLIC_APP_URL},APP_URL=${_NEXT_PUBLIC_APP_URL}",
        "--quiet"
      ]
    }
  ],
  "images": [
    "europe-west1-docker.pkg.dev/$PROJECT_ID/rupan/rupan:$BUILD_ID"
  ],
  "options": {
    "logging": "CLOUD_LOGGING_ONLY"
  }
}
